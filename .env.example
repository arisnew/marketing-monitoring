# Copy to .env (repo root or backend/) before run

APP_NAME=Marketing Monitoring
DEBUG=false

# SQLite path — in Docker use /data/app.db
DATABASE_URL=sqlite:////data/app.db

# JWT signing (min 32 chars)
SECRET_KEY=replace-with-long-random-string

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace-with-fernet-key

ACCESS_TOKEN_EXPIRE_MINUTES=1440
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEFAULT_NOTIFY_WEBHOOK_URL=

# Optional: Meta token exchange (Instagram/Facebook refresh)
META_APP_ID=
META_APP_SECRET=
